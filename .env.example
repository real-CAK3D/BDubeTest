# =============================================================================
#  EVERY SECRET, KEY AND PASSWORD THE SHOP USES
# =============================================================================
#
#  This is a LIST, not where secrets live. Real values never go in this file or
#  anywhere on GitHub (this repository is public: anyone can read it).
#
#  Real values go in one of two places:
#    [VERCEL]    Vercel > project "bdtest" > Settings > Environment Variables
#                > Add Environment Variable (type: Secret), then
#                Deployments > ... > Redeploy so the site picks it up.
#    [DASHBOARD] The shop dashboard > Accounts & keys > paste > Save.
#                Stored encrypted. No redeploy needed. (These keys can also be
#                set in Vercel with the same name; Vercel wins if both are set.)
#
#  Keep a copy of every value in a password manager (Bitwarden, 1Password,
#  iCloud Keychain, Google Password Manager), not in notes, texts or email.
#
#  Status as of handover:  SET = already done   TODO = still needed
#  Full click-by-click steps: HANDOVER.md
#
#  To run the shop on your own computer: copy this file to ".env.local"
#  (that name is ignored by GitHub, so it never gets uploaded) and fill it in.
# =============================================================================


# -----------------------------------------------------------------------------
#  REQUIRED: login and security                                     [VERCEL]
# -----------------------------------------------------------------------------

# SET. The starter password for the dashboard (/admin). Each person signs in
# with their first name + this the first time, then picks their own password.
ADMIN_PASSWORD=

# SET (replace once before handover, see HANDOVER.md Part 1, step 2).
# Locks logins and the customer details stored in the database.
# Any 40+ random characters. NEVER change it once there are real orders:
# saved customer details can only be read with the same value.
# Keep a copy in a password manager: Vercel never shows it again.
AUTH_SECRET=

# SET. Lets only Vercel run the daily self-check (/api/cron/daily).
# Any long random text. Safe to change any time.
CRON_SECRET=

# SET. The shop's web address. Change it when the shop gets its own domain
# (HANDOVER.md Part 7), then redeploy.
NEXT_PUBLIC_SITE_URL=https://bdubetest.vercel.app

# Optional. A last-resort code to get back into the dashboard if everyone
# forgets their password (Sign in > Forgot your password? > use reset code).
OWNER_RESET_CODE=


# -----------------------------------------------------------------------------
#  REQUIRED: database and photos (Supabase)                         [VERCEL]
# -----------------------------------------------------------------------------

# SET. The database address (project "Dube Family Creations").
SUPABASE_URL=https://pffizytlxaxskgyjrbgl.supabase.co

# TODO (HANDOVER.md Part 1, step 1). The database's secret key.
# Where: supabase.com/dashboard > Dube Family Creations > Project Settings >
# API Keys > Secret keys (starts with sb_secret_). The older "service_role"
# key also works (then name it SUPABASE_SERVICE_ROLE_KEY instead).
# Opens the whole database: only ever paste it into Vercel.
SUPABASE_SECRET_KEY=

# Optional. Only needed if the site can't create its own table on first run
# (it already exists). Supabase > Connect > Connection string (Session pooler).
POSTGRES_URL_NON_POOLING=


# -----------------------------------------------------------------------------
#  CARD PAYMENTS: Stripe                                           [DASHBOARD]
# -----------------------------------------------------------------------------

# TODO. dashboard.stripe.com > Developers > API keys > Secret key > Reveal.
# sk_test_... while practicing, sk_live_... for real money.
STRIPE_SECRET_KEY=

# Filled in BY ITSELF when the Stripe key is saved ("Connect Stripe webhook").
# Only paste by hand from Stripe > Developers > Webhooks > Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
#  PAYPAL, VENMO, PAY LATER (optional)                             [DASHBOARD]
# -----------------------------------------------------------------------------

# TODO if using PayPal. developer.paypal.com > Log in to Dashboard > switch to
# Live > Apps & Credentials > Create App (or Default Application).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Then: dashboard > Settings > Payments & tax > tick PayPal (Live).
#
# Cash App $cashtag, Venmo @username and Zelle email/phone are NOT secrets:
# type them in the dashboard > Settings > Payments & tax.


# -----------------------------------------------------------------------------
#  CUSTOMER EMAILS: Resend (needs the shop's own domain first)     [DASHBOARD]
# -----------------------------------------------------------------------------

# TODO after the domain (HANDOVER.md Part 7, step 4). resend.com > API Keys >
# Create API Key (Sending access). Starts with re_. Shown only once.
# Sends gift card codes, how-to-pay details, sign-in codes, tracking emails.
RESEND_API_KEY=
# Then: dashboard > Settings > Checkout & emails > "Send customer emails from".


# -----------------------------------------------------------------------------
#  SAVING DASHBOARD CHANGES TO GITHUB                              [DASHBOARD]
# -----------------------------------------------------------------------------

# TODO (HANDOVER.md Part 1, step 4). From the account that OWNS the repository:
# GitHub > profile picture > Settings > Developer settings > Personal access
# tokens > Fine-grained tokens > Generate new token > Only select repositories:
# bdubetest > Repository permissions > Contents: Read and write. github_pat_...
# Also makes the weekly locked backup (only if the repository is private).
GITHUB_SYNC_TOKEN=


# -----------------------------------------------------------------------------
#  PHONE NOTIFICATIONS                                              [DASHBOARD]
# -----------------------------------------------------------------------------

# Made BY ITSELF the first time Settings is opened (or "Create notification keys").
# Don't change them: phones that already allow notifications would stop getting them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional [VERCEL]: contact address sent with notifications, e.g. mailto:you@example.com
VAPID_SUBJECT=


# -----------------------------------------------------------------------------
#  OPTIONAL EXTRAS                                                  [DASHBOARD]
# -----------------------------------------------------------------------------

# Shipping labels from an order. goshippo.com > Settings > API > live token
# (shippo_live_...; shippo_test_ makes practice labels).
SHIPPO_API_KEY=

# Smarter chat answers. A key from the AI service chosen in dashboard > Chat >
# Settings (Anthropic, OpenAI, Gemini, Groq, OpenRouter...). The chat already
# answers on its own without one.
AI_API_KEY=


# -----------------------------------------------------------------------------
#  NOT SECRETS, BUT ACCOUNTS TO KEEP TRACK OF (store logins in a password manager)
# -----------------------------------------------------------------------------
#  Google Voice business number ... voice.google.com (HANDOVER.md Part 4)
#  UptimeRobot alerts ............. uptimerobot.com, monitor:
#                                   https://bdubetest.vercel.app/api/health
#  Domain registrar ............... wherever the domain is bought (Part 7)
#  Stripe / PayPal / Shippo / Resend account logins


# -----------------------------------------------------------------------------
#  ALTERNATIVES (not used by this shop; only if Supabase is ever replaced) [VERCEL]
# -----------------------------------------------------------------------------
# KV_REST_API_URL=            Upstash Redis instead of Supabase for data
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=      Vercel Blob instead of Supabase for photos
# PAYPAL_API_BASE=            for automated tests only; leave unset
